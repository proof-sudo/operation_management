<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="dossier_commercial_form_view" model="ir.ui.view">
    <field name="name">dossier.commercial.form</field>
    <field name="model">dossier.commercial</field>
    <field name="arch" type="xml">
        <form string="Dossier Commercial">
            <sheet>
                <group>
                    <field name="client_id"/>
                    <field name="ref_bon_commande_client"/>
                    <field name="nom_projet"/>
                </group>
                <!-- <notebook>
                    <page string="Commandes d'Achat">
                        <field name="purchase_order_ids">
                            <tree>
                                <field name="name"/>
                                <field name="date_order"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                </notebook> -->
            </sheet>
        </form>
    </field>
 </record>
 <record id="dossier_commercial_tree_view" model="ir.ui.view">
    <field name="name">dossier.commercial.tree</field>
    <field name="model">dossier.commercial</field>
    <field name="arch" type="xml">
        <list string="Dossiers Commerciaux">
            <field name="client_id"/>
            <field name="ref_bon_commande_client"/>
            <field name="nom_projet"/>
        </list>
    </field>
 </record>
<record id="dossier_commercial_action" model="ir.actions.act_window">
    <field name="name">Dossier Commercial</field>
    <field name="res_model">dossier.commercial</field>
    <field name="view_type">form</field>
    <field name="view_mode">list,form</field>
</record>
<menuitem
    id="dossier_commercial_menu"
    name="Dossier Commercial"
    sequence="10"/>

</odoo>